{
  "name": "web-dev-repo",
  "private": true,
  "description": "Git hooks for this repository: lint staged files and check commit messages.",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "prepare": "husky",
    "lint": "bash tools/lint.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "shellcheck": "^4.1.0"
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  }
}
