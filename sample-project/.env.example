# Copy to .env.local and adjust. Every VITE_* value is public: it is inlined into the bundle.
# A path, not a full URL: `pnpm dev` proxies /api to the backend (vite.config.ts), which sends no CORS headers.
VITE_API_URL=/api
# Serve API responses from the MSW handlers in src/mocks instead of a real backend.
VITE_API_MOCKING=false
